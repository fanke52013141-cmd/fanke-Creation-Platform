{
  "version": "3.1.0",
  "artifactTypes": [
    "Message", "Document", "Prompt", "Shot", "Image", "Audio", "Video",
    "Memory", "ModelRef", "Decision", "Table", "Data"
  ],
  "nodes": [
    {
      "id": "chat",
      "kind": "chat",
      "name": "对话",
      "icon": "MessageSquare",
      "description": "多轮对话节点。保留对话历史，靠系统提示词和模型驱动。",
      "dynamicPorts": true,
      "allowUpload": true,
      "inputs": [],
      "outputs": []
    },
    {
      "id": "process",
      "kind": "process",
      "name": "处理",
      "icon": "Brain",
      "description": "单次 LLM 处理节点。接受输入，调用模型，输出结果。",
      "dynamicPorts": true,
      "inputs": [],
      "outputs": []
    },
    {
      "id": "text",
      "kind": "text",
      "name": "文本",
      "icon": "FileText",
      "description": "文本容器。手动编辑或展示文本内容。",
      "inputs": [
        { "name": "content", "label": "输入文本", "type": "Document", "isConnection": true, "required": false }
      ],
      "outputs": [
        { "name": "content", "label": "文本内容", "type": "Document", "provides": ["document"] }
      ]
    },
    {
      "id": "code",
      "kind": "code",
      "name": "代码",
      "icon": "Terminal",
      "description": "Python 脚本执行节点。接收输入，执行代码，输出结果。",
      "dynamicPorts": true,
      "inputs": [],
      "outputs": []
    },
    {
      "id": "loop",
      "kind": "loop",
      "name": "循环",
      "icon": "Repeat",
      "description": "循环/批处理节点。遍历输入列表，对每个元素触发下游节点批量生成。可插入到流程中（如 处理→循环→图片生成）。",
      "dynamicPorts": true,
      "inputs": [
        { "name": "items", "label": "输入列表", "type": "Data", "isConnection": true, "array": true, "required": true }
      ],
      "outputs": [
        { "name": "results", "label": "循环结果", "type": "Data", "array": true, "provides": ["data"] }
      ]
    },
    {
      "id": "asset",
      "kind": "asset",
      "name": "资产",
      "icon": "Image",
      "description": "媒体资产节点。点击或拖拽上传图片、视频、音频。节点内显示媒体内容。支持多文件。",
      "inputs": [
        { "name": "media", "label": "媒体输入", "type": "Image", "isConnection": true, "array": true, "required": false, "accepts": ["image", "audio", "video"] }
      ],
      "outputs": [
        { "name": "media", "label": "媒体输出", "type": "Image", "array": true, "provides": ["image", "audio", "video"] }
      ]
    },
    {
      "id": "image-generator",
      "kind": "generator",
      "name": "图片生成",
      "icon": "Wand2",
      "description": "图片生成节点。调用图片生成 API，输入提示词，输出图片。可被循环节点驱动批量生成。",
      "modality": "image",
      "dynamicPorts": true,
      "inputs": [
        { "name": "prompt", "label": "提示词", "type": "Prompt", "isConnection": true, "required": true, "accepts": ["prompt"] },
        { "name": "negativePrompt", "label": "反向提示词", "type": "Prompt", "isConnection": true, "required": false }
      ],
      "outputs": [
        { "name": "images", "label": "生成图片", "type": "Image", "array": true, "provides": ["image"] }
      ]
    },
    {
      "id": "video-generator",
      "kind": "generator",
      "name": "视频生成",
      "icon": "Clapperboard",
      "description": "视频生成节点。调用视频生成 API（seedance、MiniMax H3 等），输入提示词，输出视频。可被循环节点驱动批量生成。",
      "modality": "video",
      "dynamicPorts": true,
      "inputs": [
        { "name": "prompt", "label": "提示词", "type": "Prompt", "isConnection": true, "required": true, "accepts": ["prompt"] },
        { "name": "image", "label": "参考图片", "type": "Image", "isConnection": true, "required": false, "accepts": ["image"] }
      ],
      "outputs": [
        { "name": "videos", "label": "生成视频", "type": "Video", "array": true, "provides": ["video"] }
      ]
    }
  ]
}