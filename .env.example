# ============================================================
# 无限画布 · 环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，绝不提交。
# 所有真实密钥只出现在这里，代码中一律用 process.env / os.environ 读取。
# ============================================================

# ---- OpenAI 兼容中转站（Chat 节点默认）----
# 你手头的 codex2api 网关。请使用【轮换后的新 key】，旧 key 已泄露。
OPENAI_API_KEY=sk-your-new-key-here
OPENAI_BASE_URL=https://www.codex2api.com/v1
# 默认聊天模型（variant 见 providers 配置）
OPENAI_MODEL=gpt-5.6-sol

# ---- 微信 OpenAI 兼容接口（GLM-5.2 测试脚本用）----
WEIXIN_OPENAI_TOKEN=
WEIXIN_OPENAI_MODEL=GLM-5.2

# ---- 图片生成（P2 阶段启用，届时再填）----
# JIMENG_API_KEY=
# REPLICATE_API_TOKEN=
